# Copy this to .env and fill in values — never commit .env

# PostgreSQL owner (used by Flyway for schema migrations)
POSTGRES_DB=walletwizzard
POSTGRES_USER=walletwizzard
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Application DB role (used by Spring Boot at runtime; RLS is enforced on this role)
DB_APP_USER=walletwizzard_app
DB_APP_PASSWORD=walletwizzard_app_dev

# JWT — Cognito issuer URI (e.g. https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_XXXXX)
JWT_ISSUER_URI=http://localhost:9000

# OAuth2 — MCP client auth flow (Cognito App Client, public client with PKCE)
OAUTH2_CLIENT_ID=your-cognito-app-client-id
COGNITO_DOMAIN=your-domain.auth.ap-south-1.amazoncognito.com
APP_BASE_URL=https://api.walletwizzard.com

# AWS (AppConfig + region)
AWS_REGION=ap-south-1
APP_ENV=dev
APPCONFIG_ENABLED=false

# pgAdmin (local DB browser — http://localhost:5050)
PGADMIN_EMAIL=admin@walletwizzard.local
PGADMIN_PASSWORD=changeme
PGADMIN_PORT=5050
